# Database (Neon Postgres recommended for Vercel)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth — generate secret with: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Must match your production domain (no trailing slash)
NEXTAUTH_URL="https://your-app.vercel.app"

# Optional: Pusher real-time (falls back to SSE polling if unset)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu
