# Database (local Docker: npm run db:up)
DATABASE_URL="postgresql://wishlist:wishlist@localhost:5432/wishlist"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Optional: real-time via Pusher (SSE fallback works without these)
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=
# NEXT_PUBLIC_PUSHER_KEY=
# NEXT_PUBLIC_PUSHER_CLUSTER=

# Optional: avatar uploads on Vercel Blob (local dev can skip)
# BLOB_READ_WRITE_TOKEN=

# Optional: Upstash Redis for rate limiting (recommended for production)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Email notifications via Resend (https://resend.com)
# RESEND_API_KEY=re_...

# Cron job protection — any random secret string
# CRON_SECRET=

# Sentry error monitoring (https://sentry.io)
# Client Keys (DSN) from: Settings → Projects → javascript-nextjs → Client Keys
# Must end with your real Project ID. Auth Token needs project:releases for source maps.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project-id>
# SENTRY_DSN=   # optional alias; client prefers NEXT_PUBLIC_SENTRY_DSN
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=kari-horan
# SENTRY_PROJECT=javascript-nextjs
