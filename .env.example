# Database (local Docker: npm run db:up)
DATABASE_URL="postgresql://wishlist:wishlist@localhost:5432/wishlist"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Optional: real-time via Pusher (SSE fallback works without these)
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=
# NEXT_PUBLIC_PUSHER_KEY=
# NEXT_PUBLIC_PUSHER_CLUSTER=

# Optional: avatar uploads on Vercel Blob (local dev can skip)
# BLOB_READ_WRITE_TOKEN=

# Optional: Upstash Redis for rate limiting (recommended for production)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Email notifications via Resend (https://resend.com)
# RESEND_API_KEY=re_...

# Cron job protection — any random secret string
# CRON_SECRET=

# Sentry error monitoring (https://sentry.io)
# Create a Next.js project, then paste Client Keys (DSN) and an Auth Token
# with project:releases + org:read (for source maps upload on build).
# SENTRY_DSN=https://...@o....ingest.sentry.io/...
# NEXT_PUBLIC_SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
