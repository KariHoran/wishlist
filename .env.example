# Database (local Docker: `npm run db:up`)
DATABASE_URL="postgresql://wishlist:wishlist@localhost:5432/wishlist"

# Auth.js / NextAuth (v5)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Optional alias used by some Auth.js setups / Vercel
# AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Optional: real-time via Pusher (SSE works without these)
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=
# NEXT_PUBLIC_PUSHER_KEY=
# NEXT_PUBLIC_PUSHER_CLUSTER=

# Optional: avatar uploads on Vercel Blob (local can skip — falls back without remote storage)
# BLOB_READ_WRITE_TOKEN=

# Optional: Upstash Redis for distributed rate limiting (strongly recommended in production)
# Without these, rate limits use in-memory maps per serverless instance
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Email notifications via Resend (https://resend.com)
# Without RESEND_API_KEY, in-app notifications still work; emails are skipped
# RESEND_API_KEY=re_...

# Cron job protection for /api/cron/deadline-reminders
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# Sentry error monitoring (https://sentry.io)
# Client DSN (browser + edge). Prefer the NEXT_PUBLIC_ form so the client bundle can read it.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project-id>
# SENTRY_DSN=   # optional server alias
# SENTRY_AUTH_TOKEN=   # for source maps upload during `next build`
# SENTRY_ORG=kari-horan
# SENTRY_PROJECT=javascript-nextjs
