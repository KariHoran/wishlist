generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String          @id @default(cuid())
  email                    String          @unique
  handle                   String          @unique
  displayName              String
  passwordHash             String
  avatarUrl                String?
  emailNotificationsEnabled Boolean        @default(true)
  createdAt                DateTime        @default(now())
  wishlists        Wishlist[]
  friendsA         Friendship[]    @relation("UserA")
  friendsB         Friendship[]    @relation("UserB")
  requestsSent     FriendRequest[] @relation("RequestsSent")
  requestsReceived FriendRequest[] @relation("RequestsReceived")
  contributions    Contribution[]
  reservations     Item[]          @relation("ReservedBy")
  notifications    Notification[]

  @@index([id])
}

model Friendship {
  id        String   @id @default(cuid())
  userA     User     @relation("UserA", fields: [userAId], references: [id], onDelete: Cascade)
  userAId   String
  userB     User     @relation("UserB", fields: [userBId], references: [id], onDelete: Cascade)
  userBId   String
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model FriendRequest {
  id          String        @id @default(cuid())
  from        User          @relation("RequestsSent", fields: [fromId], references: [id], onDelete: Cascade)
  fromId      String
  to          User          @relation("RequestsReceived", fields: [toId], references: [id], onDelete: Cascade)
  toId        String
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  respondedAt DateTime?

  @@unique([fromId, toId])
  @@index([toId, status])
  @@index([fromId, status])
}

model Wishlist {
  id         String    @id @default(cuid())
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String
  title      String
  emoji      String?   @default("💖")
  isPublic   Boolean   @default(false)
  deadline   DateTime?
  shareToken String    @unique @default(cuid())
  createdAt  DateTime  @default(now())
  items      Item[]

  @@index([ownerId])
  @@index([shareToken])
}

model Item {
  id                   String         @id @default(cuid())
  wishlist             Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  wishlistId           String
  name                 String
  price                Decimal        @db.Decimal(12, 2)
  imageUrl             String?
  productUrl           String?
  status               ItemStatus     @default(AVAILABLE)
  reservedBy           User?          @relation("ReservedBy", fields: [reservedById], references: [id], onDelete: SetNull)
  reservedById         String?
  reservationMessage   String?
  reservationAnonymous Boolean        @default(false)
  amountCollected      Decimal        @default(0) @db.Decimal(12, 2)
  fundingMode          FundingMode    @default(FREE)
  splitParticipants    Int?
  splitAmountPerPerson Decimal?       @db.Decimal(12, 2)
  contributions        Contribution[]
  createdAt            DateTime       @default(now())

  @@index([wishlistId])
  @@index([status])
}

model Contribution {
  id          String    @id @default(cuid())
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  amount      Decimal   @db.Decimal(12, 2)
  message     String?
  isAnonymous Boolean   @default(false)
  refunded    Boolean   @default(false)
  refundedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([itemId])
  @@index([userId])
  @@index([refunded])
}

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  payload   Json
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

enum ItemStatus {
  AVAILABLE
  RESERVED
  FUNDING
  CANCELLED
}

enum FundingMode {
  FREE
  FIXED_SPLIT
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  ITEM_RESERVED_BY_YOU
  ITEM_RESERVED
  ITEM_CONTRIBUTED
  ITEM_CANCELLED_REFUND_DUE
  REFUND_MARKED_DONE
  GOAL_REACHED
  FRIEND_REQUEST_RECEIVED
  FRIEND_REQUEST_ACCEPTED
}
